{
  "rewrites": [
    {
      "source": "/auth/tiktok/start",
      "destination": "/api/tiktok-auth"
    },
    {
      "source": "/auth/tiktok/callback",
      "destination": "/api/tiktok-callback"
    },
    {
      "source": "/auth/meta/start",
      "destination": "/api/meta-auth"
    },
    {
      "source": "/auth/meta/callback",
      "destination": "/api/meta-callback"
    },
    {
      "source": "/connections",
      "destination": "/api/connections"
    },
    {
      "source": "/auth/youtube/start",
      "destination": "/api/youtube-auth"
    },
    {
      "source": "/auth/youtube/callback",
      "destination": "/api/youtube-callback"
    }
  ],
  "headers": [
    {
      "source": "/icon-1024.png",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}